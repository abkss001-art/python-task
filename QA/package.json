{
  "name": "qa-std-realtime-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:staging": "vite --host --mode staging",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "preview": "vite preview --host",
    "deploy": "node deploy.mjs",
    "deploy:staging": "npm run build:staging && node deploy.mjs --env=staging",
    "deploy:prod": "npm run build && node deploy.mjs --env=prod",
    "rules:staging": "npx -y firebase-tools@latest deploy --only database --project staging",
    "rules:prod": "npx -y firebase-tools@latest deploy --only database --project prod"
  },
  "dependencies": {
    "firebase": "^11.3.1",
    "lucide-react": "^0.475.0",
    "mqtt": "^5.16.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
